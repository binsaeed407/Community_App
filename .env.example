# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored — never commit a real connection string.

# ---------------------------------------------------------------------------
# Neon Postgres (https://neon.tech) gives you TWO connection strings for the
# same database. They are not interchangeable.
# ---------------------------------------------------------------------------

# POOLED — used by the app at runtime. Host contains "-pooler".
# Serverless functions start and stop constantly; the pooler is what stops the
# database running out of connections.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# DIRECT — used only by `prisma migrate`. Same URL WITHOUT "-pooler".
# Migrations need advisory locks and session state that the pooler does not
# support, so schema changes have to bypass it.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Copy this file to `.env` and fill in the real value.
# `.env` is git-ignored — never commit a real connection string.

# Postgres connection string from Neon (https://neon.tech).
# Use the POOLED string: it contains "-pooler" in the host name.
# Serverless functions open and close connections constantly, and the pooler
# is what stops the database running out of them.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

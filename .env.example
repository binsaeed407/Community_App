# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored — never commit a real connection string.

# ---------------------------------------------------------------------------
# Neon Postgres (https://neon.tech) gives you TWO connection strings for the
# same database. They are not interchangeable.
# ---------------------------------------------------------------------------

# POOLED — used by the app at runtime. Host contains "-pooler".
# Serverless functions start and stop constantly; the pooler is what stops the
# database running out of connections.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# DIRECT — used only by `prisma migrate`. Same URL WITHOUT "-pooler".
# Migrations need advisory locks and session state that the pooler does not
# support, so schema changes have to bypass it.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------

# Signs and encrypts the session cookie. Any 32+ byte random string; a different
# value per environment is fine, but changing it signs everyone out.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-random-32-byte-string"

# ---------------------------------------------------------------------------
# Cloudinary (optional)
# ---------------------------------------------------------------------------
#
# Photo uploads. Leave these unset and the app still works — the report form
# simply does not offer to attach a picture.
#
# From the Cloudinary dashboard: Settings -> API Keys.
# The secret is server-only and must never be prefixed NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

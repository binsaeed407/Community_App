// Prisma schema — the single description of every table in the database.
// Run `npx prisma migrate dev` after changing this file to update the database.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Phase 0 only. This model exists to prove the chain
/// app -> Prisma -> Neon actually works end to end.
/// It is deleted in Phase 1 when the real models arrive.
model HealthCheck {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

/// Who someone is allowed to be. The PRD describes separate Moderator and
/// System Admin roles; both are collapsed into ADMIN for now because a demo has
/// no real second tier. The enum is the place to split them later.
enum Role {
  CITIZEN
  ADMIN
}

model User {
  id String @id @default(cuid())

  /// Used to sign in, and never rendered publicly. Everything the public sees
  /// uses displayName instead, so reporting a problem cannot expose an email.
  email String @unique

  /// A bcrypt hash. The plain password is never stored, logged, or returned.
  passwordHash String

  /// The only identity shown on a public page.
  displayName String

  role      Role     @default(CITIZEN)
  createdAt DateTime @default(now())

  reportedIssues Issue[]
}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

/// Categories live in the database rather than in a TypeScript enum so an
/// administrator could add one without a redeploy, and so an issue keeps a real
/// foreign key rather than a loose string.
model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  /// A single emoji, used as the map marker and the list icon. Cheaper and more
  /// portable than shipping an icon set for eight categories.
  icon String

  /// Controls the order categories appear in the report form's dropdown.
  sortOrder Int @default(0)

  issues Issue[]
}

// ---------------------------------------------------------------------------
// Issues
// ---------------------------------------------------------------------------

enum IssueStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  REJECTED
  REOPENED
}

model Issue {
  id          String @id @default(cuid())
  title       String
  description String

  /// Stored as two plain floats rather than PostGIS geometry. The only distance
  /// question this app asks is "are these two reports near each other", which a
  /// bounding box answers well enough at city scale, and this keeps the schema
  /// readable and the database portable.
  latitude  Float
  longitude Float

  /// What the reporter typed to describe where it is, e.g. "Camberwell Road,
  /// near the library". Never a full home address.
  addressLabel String

  /// A cache of the most recent IssueStatusHistory row, NOT the source of truth.
  ///
  /// The history table is authoritative. This column exists so that filtering
  /// ("show me every open issue") is one indexed lookup instead of a correlated
  /// subquery against the history table for every row.
  ///
  /// The rule that keeps it honest: this is only ever written inside the same
  /// transaction as the history row it mirrors, and never on its own. A test
  /// asserts the two can never disagree.
  status IssueStatus @default(SUBMITTED)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Serves the admin dashboard's status buckets and the public "newest first" list.
  @@index([status, createdAt])
  /// Serves the category filter on the public list.
  @@index([categoryId])
}

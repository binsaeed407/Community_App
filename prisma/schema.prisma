// Prisma schema — the single description of every table in the database.
// Run `npx prisma migrate dev` after changing this file to update the database.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Phase 0 only. This model exists to prove the chain
/// app -> Prisma -> Neon actually works end to end.
/// It is deleted in Phase 1 when the real models arrive.
model HealthCheck {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

/// Who someone is allowed to be. The PRD describes separate Moderator and
/// System Admin roles; both are collapsed into ADMIN for now because a demo has
/// no real second tier. The enum is the place to split them later.
enum Role {
  CITIZEN
  ADMIN
}

model User {
  id String @id @default(cuid())

  /// Used to sign in, and never rendered publicly. Everything the public sees
  /// uses displayName instead, so reporting a problem cannot expose an email.
  email String @unique

  /// A bcrypt hash. The plain password is never stored, logged, or returned.
  passwordHash String

  /// The only identity shown on a public page.
  displayName String

  role      Role     @default(CITIZEN)
  createdAt DateTime @default(now())

  reportedIssues Issue[]
  /// Status changes this person made. An admin accumulates these; a citizen
  /// has exactly one per issue they reported (the initial SUBMITTED row).
  statusChanges IssueStatusHistory[]

  uploads Attachment[]

  /// Actions this person took that the app considers consequential.
  auditEntries AuditLog[]

}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

/// Categories live in the database rather than in a TypeScript enum so an
/// administrator could add one without a redeploy, and so an issue keeps a real
/// foreign key rather than a loose string.
model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  /// A single emoji, used as the map marker and the list icon. Cheaper and more
  /// portable than shipping an icon set for eight categories.
  icon String

  /// Controls the order categories appear in the report form's dropdown.
  sortOrder Int @default(0)

  issues Issue[]
}

// ---------------------------------------------------------------------------
// Issues
// ---------------------------------------------------------------------------

enum IssueStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  REJECTED
  REOPENED
}

model Issue {
  id          String @id @default(cuid())
  title       String
  description String

  /// Stored as two plain floats rather than PostGIS geometry. The only distance
  /// question this app asks is "are these two reports near each other", which a
  /// bounding box answers well enough at city scale, and this keeps the schema
  /// readable and the database portable.
  latitude  Float
  longitude Float

  /// What the reporter typed to describe where it is, e.g. "Camberwell Road,
  /// near the library". Never a full home address.
  addressLabel String

  /// A cache of the most recent IssueStatusHistory row, NOT the source of truth.
  ///
  /// The history table is authoritative. This column exists so that filtering
  /// ("show me every open issue") is one indexed lookup instead of a correlated
  /// subquery against the history table for every row.
  ///
  /// The rule that keeps it honest: this is only ever written inside the same
  /// transaction as the history row it mirrors, and never on its own. A test
  /// asserts the two can never disagree.
  status IssueStatus @default(SUBMITTED)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every status this issue has ever been in, oldest first. Append-only.
  history IssueStatusHistory[]

  /// Photos: what the citizen reported, and what the admin used as proof of
  /// resolution.
  attachments Attachment[]

  /// Serves the admin dashboard's status buckets and the public "newest first" list.
  @@index([status, createdAt])
  /// Serves the category filter on the public list.
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Status history — the heart of the whole project
// ---------------------------------------------------------------------------

/// Append-only. This is the source of truth for an issue's status.
///
/// Status is not a field that gets overwritten, because a field that can be
/// overwritten can be quietly rewritten — and then the public timeline is
/// theatre rather than evidence. Instead every change adds a row, the current
/// status is the newest row, and reopening an issue appends rather than
/// resetting, so the earlier history survives it.
///
/// Nothing in this application ever issues an UPDATE or a DELETE against this
/// table. That is enforced by convention and by review, not by the database —
/// which is worth saying out loud rather than pretending otherwise.
model IssueStatusHistory {
  id String @id @default(cuid())

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  status IssueStatus

  /// Why this change was made, in the actor's own words. Required — an
  /// unexplained status change is exactly what this table exists to prevent.
  reason String

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  /// Serves the timeline on the issue detail page, and the "what is the current
  /// status" lookup used to verify the cache on Issue.
  @@index([issueId, createdAt])
}

// ---------------------------------------------------------------------------
// Photos
// ---------------------------------------------------------------------------

/// Which side of the story a photo tells.
enum AttachmentKind {
  /// Uploaded by the citizen when reporting the problem.
  REPORT
  /// Uploaded by an administrator as proof the problem was actually fixed.
  EVIDENCE
}

/// Image files live in Cloudinary, not in Postgres. The database only keeps the
/// URL and the public id, because storing megabytes of binary in a row makes
/// every query that touches the table slower and the backups enormous.
///
/// The public id is kept alongside the URL so a file can still be deleted or
/// transformed later; a bare URL would strand the asset.
model Attachment {
  id String @id @default(cuid())

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  url                String
  cloudinaryPublicId String

  kind AttachmentKind @default(REPORT)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  /// Serves "show me the evidence photo for this issue" on the detail page.
  @@index([issueId, kind])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// A record of every consequential action, written in the same transaction as
/// the action itself — so an action can never exist without its audit entry.
///
/// This overlaps with IssueStatusHistory on purpose. The history table is the
/// public timeline, written for citizens and shown on the issue page. This one
/// is the internal record, covering things that never appear publicly: an admin
/// editing a category, a login role change, an issue being hidden. They answer
/// different questions and are read by different people.
///
/// entityType and entityId are loose strings rather than a foreign key because
/// this table has to be able to describe rows in tables it does not know about,
/// including ones added later. The trade-off is that the database cannot
/// enforce that the target exists.
model AuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  /// A short verb phrase, e.g. "issue.status_changed", "issue.update_posted".
  action String

  entityType String
  entityId   String

  /// The actor's stated justification. Required for the same reason it is
  /// required on a status change: an unexplained action is not accountable.
  reason String

  createdAt DateTime @default(now())

  /// Serves "show me everything that happened to this issue".
  @@index([entityType, entityId, createdAt])
  /// Serves "show me everything this administrator did".
  @@index([actorId, createdAt])
}
